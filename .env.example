# Copie para .env na VPS (nao commitar o .env)
# URL do frontend na Vercel (separe varias por virgula)
API_CORS_ORIGINS=https://SEU-PROJETO.vercel.app
# Webhook do n8n que recebe os leads (vazio = so grava o CSV)
N8N_WEBHOOK_URL=
# Opcional: segredo enviado no cabecalho X-Mut-Secret
N8N_WEBHOOK_SECRET=
